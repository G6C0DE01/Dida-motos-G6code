# Copie este arquivo para ".env" (mesma pasta do manage.py) e ajuste os valores.
# O .env NUNCA deve ser commitado no Git (já está no .gitignore).

SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=sqlite   -> usa sqlite (arquivo local, não precisa de MySQL instalado)
# DB_ENGINE=mysql    -> usa MySQL/MariaDB (padrão)
DB_ENGINE=mysql
DB_NAME=dida_motos
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- E-mail ("Esqueci minha senha") -----------------------------------------
# Sem configurar nada, os e-mails só aparecem impressos no terminal do
# runserver (bom para desenvolvimento/apresentação). Para enviar de
# verdade em produção, descomente e preencha com os dados do seu provedor
# de e-mail (Gmail, SendGrid, etc.):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-usuario
# EMAIL_HOST_PASSWORD=sua-senha-ou-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Dida Motos <nao-responda@seudominio.com>

# --- Produção (só têm efeito quando DEBUG=False) ---------------------------
# Ative HTTPS obrigatório, HSTS e cookies seguros só depois que o site
# estiver servindo por HTTPS de verdade (proxy/servidor com certificado).
# Os valores abaixo são os padrões usados se as variáveis não forem
# definidas; normalmente não é preciso declará-las.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
